# Copie para .env.local e preencha no editor. Na Vercel, use Settings > Environment Variables.
# Nunca envie segredos por chat nem faça commit de .env.local. Guia completo: VERCEL.md.
# Homologação .vercel.app: chaves Clerk de desenvolvimento. Produção Clerk: domínio próprio/DNS.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastro
# Signing Secret do endpoint /api/webhooks/clerk. Este projeto usa este nome explicitamente.
CLERK_WEBHOOK_SECRET=
# URI Atlas com base selecionada. Transações exigem replica set; separe homologação/produção.
MONGODB_URI=
# E-mail principal verificado no Clerk; separe vários administradores por vírgula.
ADMIN_EMAILS=
# Na Vercel, substitua pela URL HTTPS desse ambiente e faça um novo deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=5586998469155
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/automotive_the/
NEXT_PUBLIC_ADDRESS=Rua Coronel Costa Araújo, 1565, Fátima, Teresina - PI (atrás do hospital São Paulo)
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Contatos têm valores padrão confirmados nos materiais. Segredos continuam vazios.
# Expediente confirmado: segunda a sábado, 8h–17h. Revise duração e capacidade no painel.

# Opcional: preencha somente se o DNS local falhar ao resolver o Atlas. Deixe vazio na Vercel.
MONGODB_DNS_SERVERS=

# Avisos por e-mail acionados manualmente no painel: Resend e remetente de domínio verificado.
RESEND_API_KEY=
# Exemplo de formato: Automotive <avisos@seu-dominio.com.br>
EMAIL_FROM=
